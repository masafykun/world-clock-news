# ============================================================
# World Clock News Bubbles - 環境変数
# このファイルをコピーして .env.local を作成してください
# cp .env.local.example .env.local
# ============================================================

# ---- OpenAI API (https://platform.openai.com) --------------
# 設定すると取得した英語ニュースをgpt-4o-miniで日本語に翻訳・要約します。
# サンプルデータは既に日本語のため、実ニュースAPI取得時のみ翻訳が実行されます。
# OPENAI_API_KEY=sk-...

# ---- NewsAPI (https://newsapi.org) -------------------------
# 無料プランで月500リクエストまで。APIキーを取得して設定。
# 設定するとNewsAPIが優先的に使用されます。
# NEWS_API_KEY=your_newsapi_key_here

# ---- The Guardian API (https://open-platform.theguardian.com) --
# 無料のテストキー "test" を使用する場合は空欄のままでOK。
# 本番用は上記URLでAPIキーを取得してください。
# GUARDIAN_API_KEY=test

# ---- New York Times API (https://developer.nytimes.com) ----
# NYT_API_KEY=your_nyt_key_here

# ---- コンテンツフィルタ ------------------------------------
# カンマ区切りで除外キーワードを設定（オプション）
# FILTER_KEYWORDS=violence,explicit

# ---- キャッシュ設定 ----------------------------------------
# ニュースキャッシュのTTL（ミリ秒）。デフォルト: 3600000 (1時間)
# NEWS_CACHE_TTL_MS=3600000
